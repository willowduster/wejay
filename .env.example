PUBLIC_URL=http://localhost:5173
LISTEN_ADDR=:8080
USER_DATA_FILE=data/users.json
# Optional in local development; required by the supplied container stack.
REDIS_URL=
# Add this callback to the Google OAuth web client:
# http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TURN is required for reliable connections across restrictive NAT/firewalls.
# Credentials are sent to authenticated room clients; use short-lived accounts.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=